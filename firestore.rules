rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // HELPERS
    // -------------------------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    // Role check from users collection (pre-approved access model)
    function getRole() {
      return isSignedIn() && authEmail() != null
        && exists(/databases/$(database)/documents/users/$(authEmail()))
        ? get(/databases/$(database)/documents/users/$(authEmail())).data.role
        : 'none';
    }

    function isAdmin() {
      return isSignedIn() && getRole() == 'admin';
    }

    function isStaff() {
      return isSignedIn() && getRole() == 'staff';
    }

    // -------------------------------------------------------------------------
    // ENTITY VALIDATIONS
    // -------------------------------------------------------------------------

    function isValidRoom(data) {
      return data.keys().hasAll(['name', 'type', 'color'])
          && data.name is string && data.name.size() <= 100
          && data.type is string && data.type.size() <= 50
          && data.color is string && data.color.size() <= 30
          && (!('guestCount' in data) || data.guestCount is number)
          && (!('singleBeds' in data) || data.singleBeds is number)
          && (!('doubleBeds' in data) || data.doubleBeds is number);
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['guestName', 'checkIn', 'checkOut', 'roomId', 'type'])
          && data.guestName is string && data.guestName.size() <= 200
          && data.checkIn is string && data.checkIn.size() == 10
          && data.checkOut is string && data.checkOut.size() == 10
          && data.roomId is string && isValidId(data.roomId)
          && data.type is string && data.type.size() <= 50
          && (!('bookingChannel' in data) || (data.bookingChannel is string && data.bookingChannel.size() <= 100))
          && (!('channelPaymentBasis' in data) || (data.channelPaymentBasis in ['bookingPrice', 'deposit', 'custom']))
          && (!('bookingChannelBasis' in data) || (data.bookingChannelBasis in ['bookingPrice', 'deposit', 'custom']))
          && (!('paymentChannelBasis' in data) || (data.paymentChannelBasis in ['bookingPrice', 'remaining', 'custom']))
          && (!('adults' in data) || data.adults is number)
          && (!('kids' in data) || data.kids is number)
          && (!('price' in data) || data.price is number)
          && (!('deposit' in data) || data.deposit is number)
          && (!('paidLater1' in data) || data.paidLater1 is number)
          && (!('paidLater2' in data) || data.paidLater2 is number)
          && (!('extras' in data) || data.extras is list)
          && (!('singleBeds' in data) || data.singleBeds is number)
          && (!('doubleBeds' in data) || data.doubleBeds is number);
    }

    function isValidProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'role'])
          && data.uid == userId
          && data.email is string && data.email.size() <= 150
          && data.role in ['admin', 'staff', 'pending']
          && (!('name' in data) || (data.name is string && data.name.size() <= 100))
          && data.role == 'pending';
    }

    function isValidConfigOption(data) {
      return data.keys().hasAll(['name'])
          && data.name is string && data.name.size() <= 100
          && (!('color' in data) || (data.color is string && data.color.size() <= 30))
          && (!('commission' in data) || data.commission is number)
          && (!('sortOrder' in data) || data.sortOrder is number);
    }

    function isValidMonthlyExpense(data) {
      return data.keys().hasAll(['month', 'amounts'])
          && data.month is string && data.month.size() == 7
          && data.month.matches('^[0-9]{4}-[0-9]{2}$')
          && data.amounts is map
          && (!('note' in data) || (data.note is string && data.note.size() <= 500))
          && (!('updatedAt' in data) || data.updatedAt is string)
          && (!('updatedBy' in data) || data.updatedBy is string)
          && (!('categoryLabels' in data) || data.categoryLabels is map)
          && (!('spreadAmounts' in data) || data.spreadAmounts is map)
          && (!('spreadIds' in data) || data.spreadIds is map);
    }

    function isValidExpenseSpread(data) {
      return data.keys().hasAll(['year', 'categoryId', 'categoryLabel', 'totalAmount', 'months', 'perMonth'])
          && data.year is int
          && data.categoryId is string && data.categoryId.size() <= 128
          && data.categoryLabel is string && data.categoryLabel.size() <= 100
          && data.totalAmount is number
          && data.months is list
          && data.perMonth is map
          && (!('note' in data) || (data.note is string && data.note.size() <= 500))
          && (!('updatedAt' in data) || data.updatedAt is string)
          && (!('updatedBy' in data) || data.updatedBy is string);
    }

    function isValidRecurringExpense(data) {
      return data.keys().hasAll(['name', 'categoryId', 'categoryLabel', 'amountPerMonth', 'active', 'monthsOfYear'])
          && data.name is string && data.name.size() <= 100
          && data.categoryId is string && data.categoryId.size() <= 128
          && data.categoryLabel is string && data.categoryLabel.size() <= 100
          && data.amountPerMonth is number && data.amountPerMonth >= 0
          && data.active is bool
          && data.monthsOfYear is list
          && (!('note' in data) || (data.note is string && data.note.size() <= 500))
          && (!('updatedAt' in data) || data.updatedAt is string)
          && (!('updatedBy' in data) || data.updatedBy is string);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt'])
          && data.uid is string
          && data.name is string && data.name.size() <= 100
          && data.email is string && data.email.size() <= 150
          && data.role in ['admin', 'staff']
          && data.createdAt is string;
    }

    function isValidHousekeeping(data) {
      return data.keys().hasAll(['roomId', 'status', 'lastUpdated'])
          && data.roomId is string
          && data.status in ['clean', 'dirty', 'inspected', 'cleaned']
          && data.lastUpdated is string;
    }

    // -------------------------------------------------------------------------
    // RULES
    // -------------------------------------------------------------------------

    // Profiles
    match /profiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isStaff());
      
      // Allow self-creation during first login
      allow create: if isSignedIn() 
                  && request.auth.uid == userId 
                  && isValidProfile(incoming(), userId);
                  
      // Allow self-update of name or admin-update of everything
      allow update: if isSignedIn() 
                  && ((request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name']))
                      || (isAdmin() && incoming().uid == existing().uid && incoming().email == existing().email));
    }

    // Rooms
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(roomId) && isValidRoom(incoming());
      allow delete: if isAdmin();
    }

    // Bookings
    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(bookingId) && isValidBooking(incoming());
      
      allow update: if (isAdmin() && isValidBooking(incoming()))
                   || (isStaff() && incoming().diff(existing()).affectedKeys().hasOnly(['comments', 'commentsUpdatedAt']));
                   
      allow delete: if isAdmin();
    }

    // Retreats
    match /retreats/{retreatId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(retreatId);
    }

    // Venue Hires
    match /venueHires/{venueHireId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(venueHireId);
    }

    // Settings
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Config Collections
    match /bookingTypes/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidConfigOption(incoming());
      allow delete: if isAdmin();
    }

    match /bookingChannels/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidConfigOption(incoming());
      allow delete: if isAdmin();
    }

    match /paymentChannels/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidConfigOption(incoming());
      allow delete: if isAdmin();
    }

    match /expenseCategories/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidConfigOption(incoming());
      allow delete: if isAdmin();
    }

    match /monthlyExpenses/{monthId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
                            && monthId.matches('^[0-9]{4}-[0-9]{2}$')
                            && monthId == incoming().month
                            && isValidMonthlyExpense(incoming());
      allow delete: if isAdmin();
    }

    match /expenseSpreads/{spreadId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidExpenseSpread(incoming());
      allow delete: if isAdmin();
    }

    match /recurringExpenses/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidRecurringExpense(incoming());
      allow delete: if isAdmin();
    }

    match /retreatTypes/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
                    && isValidUser(incoming())
                    && incoming().email == id;

      // Admin can edit users; approved users can attach uid on first login.
      allow update: if (isAdmin()
                      && isValidUser(incoming())
                      && incoming().email == existing().email
                      && incoming().email == id)
                    || (isSignedIn()
                      && authEmail() != null
                      && id == authEmail()
                      && existing().email == authEmail()
                      && existing().uid == ''
                      && incoming().uid == request.auth.uid
                      && incoming().email == existing().email
                      && incoming().role == existing().role
                      && incoming().createdAt == existing().createdAt
                      && incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'name']));

      allow delete: if isAdmin();
    }

    match /teamPositions/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teamAssignments/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Housekeeping
    match /housekeeping/{roomId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidHousekeeping(incoming());
    }

    // Activity Log
    match /activityLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }

    // Default Deny (Fallback)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
